# CI Dockerfile - builds from pre-compiled source tree (faster than building in-container)
FROM ubuntu:22.04
SHELL ["/bin/bash","-c"]

# Create keydb user
RUN groupadd -r keydb && useradd -r -g keydb keydb

# gosu for step-down from root
ENV GOSU_VERSION 1.14
RUN set -eux; \
        dpkgArch="$(dpkg --print-architecture | awk -F- '{ print $NF }')"; \
        wget -O /usr/local/bin/gosu "https://github.com/tianon/gosu/releases/download/$GOSU_VERSION/gosu-$dpkgArch"; \
        wget -O /usr/local/bin/gosu.asc "https://github.com/tianon/gosu/releases/download/$GOSU_VERSION/gosu-$dpkgArch.asc"; \
        export GNUPGHOME="$(mktemp -d)"; \
        gpg --batch --keyserver hkps://keys.openpgp.org --recv-keys B42F6819007F00F88E364FD4036A9C25BF357DD4; \
        gpg --batch --verify /usr/local/bin/gosu.asc /usr/local/bin/gosu; \
        gpgconf --kill all; \
        rm -rf "$GNUPGHOME" /usr/local/bin/gosu.asc; \
        chmod +x /usr/local/bin/gosu; \
        gosu --version; \
        gosu nobody true

# Runtime dependencies for KeyDB binaries
RUN set -eux; \
        apt-get update; \
        apt-get install -y --no-install-recommends \
                ca-certificates \
                libjemalloc2 \
                libssl3 \
                libcurl4 \
                liblz4-1 \
                libsnappy1v5 \
                libzstd1 \
                libbz2-1.0 \
                zlib1g; \
        rm -rf /var/lib/apt/lists/*

# Copy pre-built binaries from build context (src/ dir contains the compiled binaries)
COPY src/keydb-server src/keydb-cli src/keydb-benchmark \
     src/keydb-check-rdb src/keydb-check-aof \
     src/keydb-diagnostic-tool src/keydb-sentinel /usr/local/bin/
COPY keydb.conf /etc/keydb/
COPY sentinel.conf /etc/keydb/ 2>/dev/null || true

RUN cd /usr/local/bin; \
        ln -s keydb-cli redis-cli

# Create data directories
RUN mkdir -p /data /flash /etc/keydb && \
        chown keydb:keydb /data /flash && \
        # Disable protected mode and daemonize for container use
        sed -i 's/^protected-mode.*/protected-mode no/' /etc/keydb/keydb.conf; \
        sed -i 's/^daemonize.*/# &/' /etc/keydb/keydb.conf; \
        sed -i 's/^dir.*/dir \/data/' /etc/keydb/keydb.conf; \
        sed -i 's/^logfile.*/# &/' /etc/keydb/keydb.conf; \
        sed -i 's/^bind.*/# &/' /etc/keydb/keydb.conf

# symlinks for redis compatibility
RUN cd /etc/keydb; \
        ln -s keydb.conf redis.conf; \
        cd /usr/local/bin; \
        ln -s keydb-sentinel redis-sentinel

# Generate entrypoint script
RUN set -eux; \
        echo '#!/bin/sh' > /usr/local/bin/docker-entrypoint.sh; \
        echo 'set -e' >> /usr/local/bin/docker-entrypoint.sh; \
        echo "if [ \"\${1#-}\" != \"\$1\" ] || [ \"\${1%.conf}\" != \"\$1\" ]; then" >> /usr/local/bin/docker-entrypoint.sh; \
        echo "        set -- keydb-server \"\$@\"" >> /usr/local/bin/docker-entrypoint.sh; \
        echo "fi" >> /usr/local/bin/docker-entrypoint.sh; \
        echo 'if [ -n "$KEYDB_PASSWORD" ]; then' >> /usr/local/bin/docker-entrypoint.sh; \
        echo '        set -- "$@" --requirepass "${KEYDB_PASSWORD}"' >> /usr/local/bin/docker-entrypoint.sh; \
        echo 'fi' >> /usr/local/bin/docker-entrypoint.sh; \
        echo 'if [ "$1" = "keydb-server" -a "$(id -u)" = "0" ]; then' >> /usr/local/bin/docker-entrypoint.sh; \
        echo "        find . \\! -user keydb -exec chown keydb '{}' +" >> /usr/local/bin/docker-entrypoint.sh; \
        echo '        exec gosu keydb "$0" "$@"' >> /usr/local/bin/docker-entrypoint.sh; \
        echo 'fi' >> /usr/local/bin/docker-entrypoint.sh; \
        echo 'exec "$@"' >> /usr/local/bin/docker-entrypoint.sh; \
        chmod +x /usr/local/bin/docker-entrypoint.sh

VOLUME /data
WORKDIR /data
ENV KEYDB_PRO_DIRECTORY=/usr/local/bin/
ENTRYPOINT ["docker-entrypoint.sh"]
EXPOSE 6379
CMD ["keydb-server","/etc/keydb/keydb.conf"]
